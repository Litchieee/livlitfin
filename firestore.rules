rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/livlit {
      // Only the two household accounts can read or write.
      // Replace both emails with the ones you create in Firebase Authentication.
      allow read, write: if request.auth != null
        && request.auth.token.email in ['LITCH_EMAIL_HERE', 'LIV_EMAIL_HERE'];
    }
  }
}
